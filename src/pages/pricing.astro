---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Steps from '~/components/widgets/Steps.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Request a Quote',
};
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Quoting"
    title="Request a Quote"
    subtitle="We price every job individually based on your drawings, materials, and delivery requirements. There are no fixed catalogues — just a fair price for exactly what you need built."
  />

  <Features3
    title="What to include in your enquiry"
    subtitle="The more detail you give us upfront, the faster and more accurate your quote will be."
    columns={3}
    items={[
      {
        title: 'Drawings or sketches',
        description:
          'GA drawings, fabrication drawings, or even a rough sketch with key dimensions. PDF, DWG, or DXF all work.',
        icon: 'tabler:file-description',
      },
      {
        title: 'Material specification',
        description:
          'Grade, thickness, and any surface finish requirements. If unsure, tell us the service fluid and operating conditions.',
        icon: 'tabler:layers-difference',
      },
      {
        title: 'Design pressure & temperature',
        description:
          'Required for pressure vessels and heat exchangers. Include both design and operating conditions if known.',
        icon: 'tabler:gauge',
      },
      {
        title: 'Quantity',
        description:
          'Number of identical or similar items. Repeat orders often benefit from lower per-unit costs.',
        icon: 'tabler:number',
      },
      {
        title: 'Delivery timeline',
        description:
          'Your required delivery date or lead time. We will confirm feasibility and flag any constraints upfront.',
        icon: 'tabler:calendar',
      },
      {
        title: 'Testing requirements',
        description:
          'Any NDT, hydrostatic test, or third-party inspection requirements. Helps us plan the build schedule correctly.',
        icon: 'tabler:eye-check',
      },
    ]}
    classes={{ container: 'max-w-5xl' }}
  />

  <Steps
    title="How quoting works"
    tagline="our process"
    isReversed={true}
    items={[
      {
        title: 'Submit your enquiry',
        icon: 'tabler:number-1',
      },
      {
        title: 'We review your drawings and requirements',
        icon: 'tabler:number-2',
      },
      {
        title: 'We raise any technical clarifications',
        icon: 'tabler:number-3',
      },
      {
        title: 'You receive a detailed quotation',
        icon: 'tabler:number-4',
      },
      {
        title: 'Order confirmation and schedule',
        icon: 'tabler:number-5',
      },
      {
        title: 'Fabrication begins',
        icon: 'tabler:number-6',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1504328345606-18bbc8c9d7d1?auto=format&fit=crop&w=987&q=80',
      alt: 'Fabrication shop',
    }}
  />

  <CallToAction
    title="Send us your requirement"
    subtitle="Email your drawings and specs to arunironworks@outlook.com or use the contact form and we'll get back to you within one business day."
    actions={[
      {
        variant: 'primary',
        text: 'Go to contact form',
        href: '/contact',
      },
    ]}
  />
</Layout>
