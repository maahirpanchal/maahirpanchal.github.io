---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Steps from '~/components/widgets/Steps.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Request a Quotation',
  description:
    'Request a fabrication quotation from Arun Iron Works. Submit your drawings, material specifications, and design parameters for a detailed quotation.',
};
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Quotations"
    title="Request a Quotation"
    subtitle="Each enquiry is priced individually on the basis of your drawings, material specifications, and delivery requirements. We do not operate fixed-price catalogues."
  />

  <Features3
    title="Information required with your enquiry"
    subtitle="Comprehensive enquiry details enable a faster and more accurate quotation."
    columns={3}
    items={[
      {
        title: 'Engineering drawings or sketches',
        description:
          'GA drawings, fabrication drawings, or dimensioned sketches. Accepted formats: PDF, DWG, or DXF.',
        icon: 'tabler:file-description',
      },
      {
        title: 'Material specification',
        description:
          'Grade, thickness, and surface finish requirements. Where undecided, please indicate the service fluid and operating conditions.',
        icon: 'tabler:layers-difference',
      },
      {
        title: 'Design pressure & temperature',
        description:
          'Mandatory for pressure vessels and heat exchangers. Please provide both design and operating conditions where available.',
        icon: 'tabler:gauge',
      },
      {
        title: 'Quantity',
        description:
          'Number of identical or similar items required.',
        icon: 'tabler:number',
      },
      {
        title: 'Required delivery schedule',
        description:
          'Specified delivery date or acceptable lead time. Feasibility will be confirmed and any scheduling constraints communicated at the outset.',
        icon: 'tabler:calendar',
      },
      {
        title: 'Testing & inspection requirements',
        description:
          'NDT methods, hydrostatic test parameters, or third-party inspection scope, as applicable. Required for accurate build schedule planning.',
        icon: 'tabler:eye-check',
      },
    ]}
    classes={{ container: 'max-w-5xl' }}
  />

  <Steps
    title="The quotation process"
    tagline="Our process"
    isReversed={true}
    items={[
      {
        title: 'Enquiry submitted',
        icon: 'tabler:number-1',
      },
      {
        title: 'Drawings and specifications reviewed',
        icon: 'tabler:number-2',
      },
      {
        title: 'Technical clarifications raised, if required',
        icon: 'tabler:number-3',
      },
      {
        title: 'Detailed quotation issued',
        icon: 'tabler:number-4',
      },
      {
        title: 'Order confirmation and production schedule',
        icon: 'tabler:number-5',
      },
      {
        title: 'Fabrication commences',
        icon: 'tabler:number-6',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1581094488379-6a10d04c0f04?q=80&w=1740&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D',
      alt: 'Fabrication shop',
    }}
  />

  <CallToAction
    title="Submit your requirement"
    subtitle="Forward your drawings and specifications to arunironworks@outlook.com, or submit via the contact form. All enquiries are responded to within one business day."
    actions={[
      {
        variant: 'primary',
        text: 'Open contact form',
        href: '/contact',
      },
    ]}
  />
</Layout>
